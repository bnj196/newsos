# ==========================================
# CẤU HÌNH ZALO SOS BOT (S0szalo)
# ==========================================

# Thông tin tài khoản Zalo của Bot
ZALO_PHONE=84793634088
ZALO_PASSWORD=;;;tuienBin
ZALO_IMEI=5fe2bd7c-47ae-461e-914f-cf01e4670243-16453d6e2683b8800ded2a27c7f595d9

# File lưu cookie phiên đăng nhập (tương thích chạy Docker với volume mount)
COOKIE_FILE=/app/data/zalo_cookies.json

# Cấu hình nhóm nội bộ (Internal Group) để nhận lệnh điều khiển SOS
# Có thể dùng ID nhóm hoặc Tên nhóm (Bot sẽ tự tìm kiếm ID nhóm theo tên nếu chưa có ID)
INTERNAL_GROUP_ID=
INTERNAL_GROUP_NAME=test group

# Danh sách Zalo UID admin được phép ra lệnh (cách nhau bởi dấu phẩy, để trống nếu cho phép tất cả thành viên trong nhóm nội bộ)
ADMIN_USER_IDS=

# Đường dẫn file SQLite Database lưu trữ cấu hình, danh bạ SOS và trạng thái phiên
DB_PATH=/app/data/sos_database.db

# Thời gian đếm ngược mặc định (phút) nếu người dùng không truyền tham số
DEFAULT_TIMEOUT_MINUTES=30

# Cấu hình cảnh báo trước khi hết hạn (giây, cách nhau bởi dấu phẩy: ví dụ 300=5 phút, 60=1 phút)
WARNING_SECONDS_BEFORE=300,60

# Port cho HTTP Server Healthcheck & Webhook API
PORT=8080
